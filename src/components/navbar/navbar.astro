---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { UI, href, otherLang, SOLUTION_SLUGS, type Lang } from "@/lib/i18n";

const { lang } = Astro.props as { lang: Lang };
const t = UI[lang];

const menuitems = [
  {
    title: t.solutions,
    path: "#",
    children: [
      ...SOLUTION_SLUGS.map((slug) => ({ title: t.solutionNames[slug], path: href(lang, `solutions/${slug}/`) })),
      { title: t.consulting, path: href(lang, "consulting/") },
    ],
  },
  { title: t.sectors, path: href(lang, "#sectors") },
  { title: t.about, path: href(lang, "about/") },
  { title: t.reach, path: href(lang, "#contact") },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href={href(lang)} aria-label={t.home}>
          <img src="/assets/brand/autoxtion-logo.svg" alt="AUTOXTION" width="190" height="18" class="h-4 w-auto" />
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item) => (
              <>
                {item.children && <Dropdown title={item.title} children={item.children} lastItem={false} />}

                {!item.children && (
                  <li>
                    <a href={item.path} class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-gray-900">
                      <span> {item.title}</span>
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <Link href={otherLang(lang, Astro.url.pathname)} style="muted" block size="md">{t.otherName}</Link>
          <Link href={href(lang, "#contact")} size="md" block>{t.contact}</Link>
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <a href={otherLang(lang, Astro.url.pathname)} hreflang={lang === "ar" ? "en" : "ar"}>{t.other}</a>
        <Link href={href(lang, "#contact")} size="md">{t.contact}</Link>
      </div>
    </div>
  </header>
</Container>
