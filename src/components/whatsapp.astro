---
import { Icon } from "astro-icon/components";
import { UI, CONTACT, type Lang } from "@/lib/i18n";
const { lang } = Astro.props as { lang: Lang };
const t = UI[lang];
const url = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(t.whatsappText)}`;
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  aria-label={t.whatsapp}
  title={t.whatsapp}
  class="whatsapp-float fixed bottom-5 start-5 z-50 grid place-items-center w-12 h-12 rounded-full bg-black text-white hover:bg-gray-800 transition">
  <Icon class="w-6 h-6" name="bx:bxl-whatsapp" />
</a>
