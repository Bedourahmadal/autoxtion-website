---
// The consultations as cards: a title, one sentence, the session's details where it has them,
// and an arrow in the bottom corner. The whole card leads to the request form with that
// consultation chosen (site.ts reads data-open-form).
interface Props {
  arrow: string;
  rows: { title: string; text: string; option: string; chips?: string[] | null }[];
}
const { arrow, rows } = Astro.props;
---

<ul class="grid md:grid-cols-2 gap-6 mx-auto max-w-5xl mt-12">
  {rows.map((r) => (
    <li data-service={r.option}>
      <a
        href="#request"
        data-open-form={r.option}
        class="group flex flex-col h-full rounded-xl border border-[#DEDEDC] bg-[#F2F2F0] p-8 transition hover:bg-[#EBEBE8] hover:border-black">
        <h3 class="text-2xl font-bold">{r.title}</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">{r.text}</p>
        {r.chips && (
          <ul class="flex flex-wrap gap-2 mt-4">
            {r.chips.map((c) => <li class="text-xs text-slate-600 bg-white rounded-full px-3 py-1">{c}</li>)}
          </ul>
        )}
        <div class="mt-auto pt-6 flex justify-end">
          <span
            class="grid place-items-center w-11 h-11 rounded-full border border-[#BDBDBA] bg-white text-lg transition group-hover:bg-black group-hover:text-white group-hover:border-black"
            aria-hidden="true">{arrow}</span>
        </div>
      </a>
    </li>
  ))}
</ul>
