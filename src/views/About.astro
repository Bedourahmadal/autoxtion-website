---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Cta from "@/components/cta.astro";
import { UI, href, type Lang } from "@/lib/i18n";
import data from "@/data/home.json";

const { lang } = Astro.props as { lang: Lang };
const d = data[lang];
const t = UI[lang];
---

<Layout lang={lang} title={`${d.about.eyebrow} | AUTOXTION`} description={d.about.lead}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{d.about.eyebrow}</Fragment>
      <Fragment slot="desc">{d.about.title}</Fragment>
    </Sectionhead>

    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-16">
      <h2 class="font-bold text-3xl text-gray-800">
        {d.hero.h1}
      </h2>
      <p class="text-lg leading-relaxed text-slate-500">
        {d.about.lead}
      </p>
      <p class="text-lg leading-relaxed text-slate-500">
        {d.about.text}
      </p>
    </div>
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-16">
      <h2 class="font-bold text-3xl text-gray-800">
        {d.stack.title}
      </h2>
      <p class="text-lg leading-relaxed text-slate-500">
        {d.stack.lead}
      </p>
    </div>
    <Cta title={d.contact.title} text={d.contact.lead} button={{ text: t.contact, href: href(lang, "#contact") }} />
  </Container>
</Layout>
