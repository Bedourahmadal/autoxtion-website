---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Hero from "@/components/hero.astro";
import PricingCard from "@/components/pricing.astro";
import OfferList from "@/components/offerlist.astro";
import ProgramCards from "@/components/programcards.astro";
import Contactform from "@/components/contactform.astro";
import Link from "@/components/ui/link.astro";
import { type Lang } from "@/lib/i18n";
import data from "@/data/consulting.json";

const { lang } = Astro.props as { lang: Lang };
const d = data[lang];
type Item = [string, string, string, string[] | null];
type Prog = [string, string, string, string];
const items = d.items as Item[];
const progs = d.progs as Prog[];
const kickers = ["AI SYSTEMS", "XR"];
const first = (p: { short?: string; name: string }) => p.short ?? p.name.split(" ")[0];

const arrow = lang === "ar" ? "←" : "→";
const services = items.map(([title, text, , chips]) => ({ title, text, option: title, chips }));
const programs = progs.map(([title, tag, text, option]) => ({ title, text, option, tag }));
---

<Layout lang={lang} title={d.title} description={d.desc}>
  <Hero title={d.h1} lead={d.lead} primary={{ text: d.cta, href: "#request" }} />

  <Container>

    <div class="mt-24 text-center">
      <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">{d.offer_h}</h2>
    </div>
    <OfferList arrow={arrow} rows={services} />

  </Container>

  <section id="programs" class="hero-dots relative overflow-hidden mt-24 py-20 md:py-24 text-white">
    <div class="relative max-w-(--breakpoint-xl) mx-auto px-5">
      <div class="text-center">
        <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">{d.prog_h}</h2>
        <p class="text-lg mt-4 text-white/70">{d.prog_lead}</p>
      </div>
      <ProgramCards cards={programs} />
    </div>
  </section>

  <Container>

    <div class="mt-24 text-center">
      <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">{d.team_h}</h2>
      <p class="text-lg mt-4 text-slate-600">{d.team_lead}</p>
    </div>
    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-5xl mt-12">
      {d.people.map((m, i) => (
        <PricingCard
          plan={{
            name: `0${i + 1} / ${kickers[i]}`,
            price: m.name,
            popular: false,
            features: [m.role, ...m.bio, ...m.creds],
            button: { text: `${d.with_} ${first(m)}`, link: "#request", form: "", consultant: m.name },
          }}
        />
      ))}
    </div>

    <div class="grid lg:grid-cols-[1fr_1.3fr] gap-10 lg:gap-16 mx-auto max-w-5xl mt-24 scroll-mt-8" id="request">
      <div>
        <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">{d.form_h}</h2>
        <p class="text-lg leading-relaxed text-slate-500 mt-3">{d.form_lead}</p>
        <h3 class="mt-8 font-semibold text-gray-800">{d.how_h}</h3>
        <ol class="mt-3 grid gap-3">
          {(d.steps as [string, string][]).map(([h, p], i) => (
            <li class="flex gap-3 text-gray-600"><span class="font-bold text-black">{i + 1}.</span><span><b class="text-gray-800">{h}</b> {p}</span></li>
          ))}
        </ol>
      </div>
      <div>
        <Contactform
          lang={lang}
          subject="New AI Consultation Request - Autoxtion"
          aria={d.aria}
          labels={{ name: d.name, company: d.company, email: d.email, phone: d.phone, purpose: d.type_l, notes: d.notes }}
          choose={d.choose}
          purposes={[...items.map((x) => x[0]), ...progs.map((x) => x[3]), d.unsure]}
          send={d.send}
          notesPlaceholder={d.ph}
          notesRequired
          phoneRequired
          consultants={{ label: d.pref, none: d.no_pref, names: d.people.map((m) => m.name) }}
          ok={d.ok}
          error={d.err}
          required={d.req}
          pick={d.pick}
        />
      </div>
    </div>
  </Container>

  <!-- phones: the request button kept at hand until the form is on screen -->
  <div data-sticky-cta class="fixed inset-x-0 bottom-0 z-40 translate-y-full bg-white border-t p-3 transition-transform sm:hidden [body[data-show-sticky]_&]:translate-y-0">
    <Link href="#request" data-open-form="" block>{d.cta}</Link>
  </div>
</Layout>
